                        (column-source :index (RegDefUseBlockLastDef 2 0 1) :ver FULL :prefix (reg))
                      ))
                    (cartesian-join :vars (_gen8 eaUsed index _gen9 _gen10 eaDef) :var-from-source ((_gen8 eaUsed index) (_gen9 _gen10) (eaDef))
