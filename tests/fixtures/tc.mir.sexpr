(program ((relation-schema Edge (int int) NoProvenance "" "" #f) (relation-schema ArcInput (int int) NoProvenance "" "" #f) (relation-schema Path (int int) NoProvenance "" "" #f)) (
  (step #f
    (fixpoint-plan (
      (execute-pipeline EdgeLoad (tuple ((index-spec ArcInput (0 1) full))) (tuple ((index-spec Edge (0 1) full))) (
        (scan (x y) ArcInput (0 1) full ())
        (insert-into Edge new (0 1) (x y))))
      (rebuild-index Edge (0 1) new)
      (check-size Edge new)
      (compute-delta-index Edge (0 1))
      (clear-relation Edge new)
      (merge-index Edge (0 1)))))
  (step #f
    (post-stratum-reconstruct-intern-cols Edge (0 1)))
  (step #f
    (fixpoint-plan (
      (execute-pipeline TCBase (tuple ((index-spec Edge (0 1) full))) (tuple ((index-spec Path (1 0) full))) (
        (scan (x y) Edge (0 1) full ())
        (insert-into Path new (1 0) (x y))))
      (rebuild-index Path (1 0) new)
      (check-size Path new)
      (compute-delta-index Path (1 0))
      (clear-relation Path new)
      (merge-index Path (1 0)))))
  (step #f
    (post-stratum-reconstruct-intern-cols Path (1 0)))
  (step #t
    (fixpoint-plan (
      (execute-pipeline TCRec_D0 (tuple ((index-spec Path (1 0) delta) (index-spec Edge (0 1) full) (index-spec Path (1 0) delta) (index-spec Edge (0 1) full))) (tuple ((index-spec Path (1 0) full))) (
        (column-join y ((column-source Path (1 0) delta ()) (column-source Edge (0 1) full ())))
        (cartesian-join (x z) ((x) (z)) ((column-source Path (1 0) delta (y)) (column-source Edge (0 1) full (y))))
        (insert-into Path new (1 0) (x z))))
      (rebuild-index Path (1 0) new)
      (clear-relation Path delta)
      (check-size Path new)
      (compute-delta-index Path (1 0))
      (clear-relation Path new)
      (merge-index Path (1 0)))))
  (step #f
    (post-stratum-reconstruct-intern-cols Path (1 0)))))
