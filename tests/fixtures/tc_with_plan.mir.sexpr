(program ((relation-schema P (int int) NoProvenance "" "" #f) (relation-schema Seed (int int) NoProvenance "" "" #f)) (
  (step #f
    (fixpoint-plan (
      (execute-pipeline Base (tuple ((index-spec Seed (1 0) full))) (tuple ((index-spec P (0 1) full))) (
        (scan (y x) Seed (1 0) full ())
        (insert-into P new (0 1) (x y))))
      (rebuild-index P (0 1) new)
      (check-size P new)
      (compute-delta-index P (0 1))
      (clear-relation P new)
      (merge-index P (0 1))
      (rebuild-index-from-index P (0 1) P (1 0) delta)
      (merge-index P (1 0)))))
  (step #f
    (post-stratum-reconstruct-intern-cols P (0 1)))
  (step #t
    (fixpoint-plan (
      (parallel-group (
        (execute-pipeline Compose_D0 (tuple ((index-spec P (0 1) delta) (index-spec P (0 1) full) (index-spec P (0 1) delta) (index-spec P (0 1) full))) (tuple ((index-spec P (0 1) full))) (
          (column-join y ((column-source P (0 1) delta ()) (column-source P (0 1) full ())))
          (cartesian-join (x z) ((x) (z)) ((column-source P (0 1) delta (y)) (column-source P (0 1) full (y))))
          (insert-into P new (0 1) (x z))))
        (execute-pipeline Compose_D1 (tuple ((index-spec P (1 0) delta) (index-spec P (1 0) full) (index-spec P (1 0) delta) (index-spec P (1 0) full))) (tuple ((index-spec P (0 1) full))) (
          (column-join y ((column-source P (1 0) delta ()) (column-source P (1 0) full ())))
          (cartesian-join (z x) ((z) (x)) ((column-source P (1 0) delta (y)) (column-source P (1 0) full (y))))
          (insert-into P new (0 1) (x z))))))
      (rebuild-index P (0 1) new)
      (clear-relation P delta)
      (check-size P new)
      (compute-delta-index P (0 1))
      (clear-relation P new)
      (merge-index P (0 1))
      (rebuild-index-from-index P (0 1) P (1 0) delta)
      (merge-index P (1 0)))))
  (step #f
    (post-stratum-reconstruct-intern-cols P (0 1)))))
